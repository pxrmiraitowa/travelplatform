# Docker Compose project and versioned application image tag
COMPOSE_PROJECT_NAME=travel-platform
IMAGE_TAG=0.1.0

# MySQL container settings (local demo values only)
MYSQL_DATABASE=travel_platform
MYSQL_ROOT_PASSWORD=travel-platform-local-db-password

# Backend settings; replace this value before any shared deployment
JWT_SECRET=travel-platform-local-jwt-secret-change-before-deploy-2026
AI_PLANNER_ENABLED=false

# Host port exposed by the frontend container
FRONTEND_PORT=8088
